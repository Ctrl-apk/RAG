{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    
    /* 2026 MODERN SETTINGS */
    "rewriteRelativeImportExtensions": true, 
    "allowImportingTsExtensions": true,
    "noEmit": false 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}